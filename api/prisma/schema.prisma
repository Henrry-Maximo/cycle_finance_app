generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id            String @id @default(uuid(7)) @db.Uuid
  name          String
  email         String @unique
  password_hash String

  role Role @default(MEMBER)

  terms_accepted_at DateTime @default(now())
  terms_version     String   @default("1.0")

  categories Category[]
  expenses   Expense[]

  @@map("users")
}

model Expense {
  id               String   @id @default(uuid(7)) @db.Uuid
  title            String
  enterprise       String
  description      String?
  cnpj             String?
  source           String?
  price            Int
  card_last_digits String   @db.Char(4)
  created_at       DateTime @default(now())

  user    User   @relation(fields: [user_id], references: [id])
  user_id String @db.Uuid // CORREÇÃO: Deve ser @db.Uuid para casar com User.id

  category    Category @relation(fields: [category_id], references: [id])
  category_id String   @db.Uuid

  @@map("expenses")
}

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  created_at  DateTime @default(now())

  user    User   @relation(fields: [user_id], references: [id])
  user_id String @db.Uuid

  expenses Expense[]

  @@unique([user_id, title])
  @@map("categories")
}
